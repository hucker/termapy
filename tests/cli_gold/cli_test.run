# CLI gold-standard test - deterministic commands only
# Exercises device commands, REPL commands, variables, config, port control,
# protocol CRC, environment variables, and error handling.
# Every command family is here, or NOT_IN_GOLD in tests/test_architecture.py
# says why it cannot be (registry command-in-gold).
# Skip: AT+TEMP, AT+INFO, AT+STATUS, AT+RESET, NMEA (nondeterministic device replies)

# ── Device commands ──────────────────────────────────────────────────────────
/print === section: device commands ===
AT
AT+PROD-ID
AT+LED on
AT+LED off
AT+NAME?
AT+NAME=TestDevice
AT+NAME?
AT+BAUD?
mem 0x1000 32
mem 0x2000 16
AT+TEXTDUMP 3
BOGUS
AT+LED on
AT+LED off

# ── REPL: print and echo ────────────────────────────────────────────────────
# /term.echo governs echo of DEVICE commands; /term.echo_repl governs echo of
# REPL/slash commands like /print (see the two-echo split).  This section
# toggles the REPL echo since it exercises slash commands.
/print === section: print and echo ===
/term.echo_repl off
/print repl echo is off - this output appears, with no command-echo above it
/term.echo_repl on
/print repl echo is on - this output appears with its command-echo above it

# ── REPL: variables (set/use/clear, but don't list all - times are dynamic)
/print === section: variables ===
$(DEVICE) = BASSOMATIC
$(PORT_NUM) = 42
/print device=$(DEVICE) port=$(PORT_NUM)
/var DEVICE
/var PORT_NUM
/var.set DEVICE updated_value
/var DEVICE
$(BAUD) <- /port.baud_rate
/var BAUD
/var.clear
/var DEVICE
# A name that names nothing warns with the one it meant, and the line runs as typed
/print $(CFG.FIRMWAR_DIR)

# ── REPL: config queries ────────────────────────────────────────────────────
/print === section: config read ===
/cfg baud_rate
/cfg serial
/cfg encoding
/cfg eol
/cfg parity
/cfg byte_size
/cfg stop_bits
/cfg flow_control
/cfg echo
/cfg send_bare_enter
/cfg cmd_prefix
/cfg quiet_start

# ── REPL: config auto-set (no confirmation dialog) ──────────────────────────
/print === section: config auto-set ===
/cfg.auto echo true
/cfg echo
/cfg.auto echo false
/cfg echo
/term.echo
/cfg.auto echo true
# A key that starts a session flag moves it, and the setter reports it.
/cfg.auto output_level quiet
/term.output
/cfg.auto output_level normal
/term.output
/cfg.auto output_level loud
/help output_level
# The words commands share have pages of their own.
/help cycle
/help json
/help.idioms
# A page shows what is about the command; --verbose shows the rest.
/help term.hex
/help term.hex --verbose
/cfg.auto custom_buttons_side Right
/cfg custom_buttons_side
/cfg.auto custom_buttons_side up
/cfg.auto custom_buttons_side bottom
# One validator: what a load warns about, /cfg refuses (registry cfg-schema-one-table)
/cfg.auto max_lines 0
/cfg.auto encoding nope
/cfg.auto eol_rx nope
/cfg.auto config_version 99

# ── REPL: config dump (full JSON) ───────────────────────────────────────────
/print === section: config dump ===
/cfg.dump

# ── REPL: what the config load loaded (the startup table) ───────────────────
/print === section: config loaded ===
/cfg.loaded
/help /cfg.loaded

# ── REPL: config new / rename / delete (never the active config) ────────────
/print === section: config new ===
/cfg.new gold_new loop:// 9600 E71
/cfg.new gold_bad 115200 8N1
/cfg.new
/cfg.rename gold_new gold_renamed
/cfg.rename demo gold_other
/cfg.delete demo
/cfg.delete nosuch

# ── REPL: config folder listings ────────────────────────────────────────────
/print === section: config folders ===
/run.list
/proto.list
/cap.list

# ── REPL: port control - read all properties ────────────────────────────────
/print === section: port read ===
/port.baud_rate
/port.parity
/port.byte_size
/port.stop_bits
/port.flow_control
/port.dtr
/port.rts
/port.cts
/port.dsr
/port.ri
/port.cd
/port.info

# ── REPL: port control - modify properties ──────────────────────────────────
/print === section: port modify ===
/port.dtr 0
/port.dtr
/port.dtr 1
/port.dtr
/port.rts 0
/port.rts

# ── REPL: port control - disconnect and reconnect ───────────────────────────
/print === section: port disconnect/connect ===
/port.disconnect
/port.baud_rate
/port.connect
/port.baud_rate
# A timed connect to a port that never opens: the message, then the reason
/port.disconnect
/print port=[$(PORT.NAME)] state=$(PORT.STATE) serial=[$(PORT.SERIAL)] dtr=[$(PORT.DTR)]
/port.connect DEMO_FAIL timeout=300ms msg=Waiting for a port that never opens...
/port.connect DEMO

# ── REPL: port break ────────────────────────────────────────────────────────
/print === section: port break ===
/port.break
/port.break 100

# ── REPL: port subcommand listing ───────────────────────────────────────────
/print === section: port subcommands ===
/port.help

# ── REPL: term.eol.markers toggle ──────────────────────────────────────────
/print === section: line endings ===
/term.eol.markers on
/term.eol.markers off

# ── REPL: sequence counters ─────────────────────────────────────────────────
/print === section: seq ===
/seq
/print seq1={seq1+} seq2={seq2+}
/print seq1={seq1+} seq2={seq2}
/seq
/seq.reset
/seq

# ── REPL: protocol CRC tools ────────────────────────────────────────────────
/print === section: proto crc ===
/proto.crc.info crc16-modbus
/proto.crc.calc crc16-modbus 01 03 00 00 00 0A
/proto.crc.calc crc8-maxim 48 65 6C 6C 6F
/proto.crc.calc crc32 01 02 03 04

# ── REPL: symbols (demo.symbols.json auto-loads with the demo config) ───────
# No real /sym.import here: the file it writes carries a wall-clock timestamp.
/print === section: symbols ===
/sym.info
/sym main
/sym 0x2010
/sym gTemp
/sym 4096
/sym 1000
/sym main+0x10
/sym count.12
/sym count.12+4
/sym kBaud
/sym CONSOLE
/sym CONSOLE_MODE
/sym.search CONSOLE_*
/mem.read CONSOLE_MODE.ON
/sym tick
/sym tick@adc.c
/sym U1MODE.ON
/sym nosuch
/sym.search g*
/sym.search mon
/sym.search ^Mon
/sym.search zzz
/sym.import nosuch.map
/dev.import nosuch.svd
/sym.load nosuch.json
/sym.unload
/sym gTemp
/sym.load

# ── REPL: memory (demo RAM behind MEM.R/MEM.W, deterministic seed) ─────────
/print === section: memory ===
/mem.info
/mem.dump gTemp 16
/mem.dump gTemp 0x10
/mem.dump 0x2000 4
/mem.dump main+0x10 8
/mem.write gFlags 7
/mem.dump gFlags 4
/mem.dump U1MODE.ON 4
/mem.dump nosuch
/mem.dump 0x9000 4
/mem.write 0x1000 ZZ
/mem.dump 0x1000 0
# The space form redirects to the dotted subcommand
/mem dump gTemp 2
/mem bogus
# Bare /mem = /mem.info (bare_sub): the availability check
/mem
# The same bytes through the device's own `mem` grammar (template dialect)
/profile.load demo_legacy.profile.json
/mem.info
/mem.dump gTemp 16
/mem.write gTemp 300
/mem.dump gTemp 4
/mem.dump 0x9000 4
/profile.unload
/mem.dump gTemp 2
# Typed reads, bits, strings (state so far: gTemp=300 from the template write,
# gFlags=7 from the native write)
/mem.read gTemp
/mem.read gPressure
/mem.read U1MODE
/mem.read U1MODE.ON
/mem.read sBanner char
/mem.str sBanner
/mem.write U1MODE.ON 0
/mem.read U1MODE.ON
/mem.or gFlags 0x10
/mem.xor gFlags 0x01
/mem.clear gFlags 0x02
/mem.not gTemp
/mem.not gTemp
/mem.or U1STA 1
/mem.write U1MODE.ON 2
/mem.read 0x1000
/mem.dump gTemp 16 u16
/mem.dump gTemp 4 addr=off ascii=off
# A named target stays inside its symbol.  sCount is 2 bytes with no type,
# as a linker map gives it; code and constants are read-only.
/mem.read sCount
/mem.write sCount 513
/mem.read sCount
/mem.write gPressure 2.5
/mem.read gPressure
/mem.read gTemp u32
/mem.write gTemp 2C01
/mem.write gTemp+1 0102
/mem.read sBanner
/mem.write sBanner 41
/mem.not main
# An ELF types an array by its element and a struct by its members.
/mem.read sCmdTable
/mem.dump sCmdTable u32
/mem.read sCfg
/mem.write sCfg 0302
/mem.read sCfg
MEM.M 0x1000 F0 05 --json
# /term.json_fmt lays JSON out on screen only: into this pipe a device's JSON line
# comes as it arrived, whatever the indent says.
/term.json_fmt
/term.json_fmt.highlight
/term.json_fmt.indent 4
MEM.INFO
/term.json_fmt indent 2

