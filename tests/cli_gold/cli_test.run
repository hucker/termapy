# -- A load starts clean: what this session changed is gone -----------------
/print === section: a load starts clean ===
/help cfg.load
/var.set GOLD_LOAD_VAR 1
/env.set GOLD_LOAD_ENV 1
/print {seq7+}
/term.output verbose
/cfg.load demo
/term.output
/var GOLD_LOAD_VAR
/env.list GOLD_LOAD_ENV
/print {seq7+}

# -- A person's job: an MCP client cannot rename or delete a file ------------
/print === section: rename and delete need a person ===
/help cap.rename

# -- A spy:// log takes only a path relative to cap/ -------------------------
/print === section: spy log stays in cap ===
/port spy://NO-SUCH-PORT?file=../traffic.txt
/port DEMO
