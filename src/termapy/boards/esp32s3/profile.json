{
    "profile_version": 2,
    "profile_revision": "1.0.0",
    "profile_date": "2026-10-26",
    "device": {
        "name": "ESP32-S3 DevKitC-1 (termapy starter, MicroPython)",
        "vendor": "Espressif",
        "model": "ESP32-S3-DevKitC-1"
    },
    "types": {
        "on_off": {"kind": "enum", "values": ["on", "off"], "help": "LED state: on or off."}
    },
    "error_detection": {
        "pattern": "\"error\"\\s*:\\s*\\{[^}]*\"message\"\\s*:\\s*\"(?P<message>[^\"]*)\"",
        "async": false,
        "types": {"message": "str"}
    },
    "commands": {
        "help": {
            "help": "The board's commands, each name mapped to its one-line help.",
            "safety": "readonly",
            "response": {"format": "json", "timeout_ms": 500}
        },
        "led": {
            "help": "Turn the RGB LED on (a dim white) or off; the reply is the new state.",
            "send_template": "led {state}",
            "typed_args": [
                {"name": "state", "type": "on_off", "required": true, "help": "LED state."}
            ],
            "safety": "mutable",
            "response": {"format": "json", "timeout_ms": 500}
        },
        "temp": {
            "help": "Read the chip's temperature sensor, in whole degrees Celsius, as a number.",
            "safety": "readonly",
            "response": {"format": "json", "timeout_ms": 500}
        },
        "id": {
            "help": "The chip's unique ID in hex, its factory MAC address.",
            "safety": "readonly",
            "response": {"format": "json", "timeout_ms": 500}
        }
    }
}
