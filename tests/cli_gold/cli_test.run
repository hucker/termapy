# ── REPL: cap.poll ──────────────────────────────────────────────────────────
/print === section: cap.poll ===
/cap.poll count=3 delay=0 --notime cmd=AT+RAMP
# param error: enum value not in the allowed set (fails at parse, deterministic)
/cap.poll fmt=bogus cmd=AT

# ── REPL: repeat ────────────────────────────────────────────────────────────
/print === section: repeat ===
/repeat count=3 cmd=/print hello
/repeat count=3 var=I cmd=/print iteration $(I)
/repeat cmd=AT
/repeat count=0 cmd=AT
/repeat count=abc cmd=AT
# more param errors: bad duration value, and an unexpected positional token
/repeat count=1 delay=xyz cmd=AT
/repeat foo count=1 cmd=AT

# ── REPL: environment variables ─────────────────────────────────────────────
/print === section: env vars ===
/env.set TERMAPY_GOLD_VAR hello_world
/env.list TERMAPY_GOLD_VAR
/env.set TERMAPY_GOLD_VAR updated
/env.list TERMAPY_GOLD_VAR
/env.list zzz_no_such_*

# ── REPL: error handling ────────────────────────────────────────────────────
/print === section: errors ===
/nonexistent_command
/cfg nonexistent_key
/port.baud_rate not_a_number
# A rate off the standard list is a typo until custom=true says otherwise
/port.baud_rate 11520
/port.mode 11520 8N1
/port.baud_rate 9460 custom=true
/port.baud_rate
/port.baud_rate 115200
/cfg custom_baud false
/port.parity X
/port.dtr maybe
/port.break -5

# ── Capability gates (tui_mode + screen_capture) ────────────────────────────
# Demo CLI lacks TUI capabilities, so commands declaring tui_mode or
# screen_capture fail with a uniform "/cmd requires: <cap> (not available in
# this environment)" message.  Other capability gates (serial_connected,
# block_until) are covered by unit tests because the gold harness runs in
# --demo mode (connected), which satisfies serial_connected, and .run files
# satisfy block_until -- neither reaches the gate here.
/print === section: capability gates (tui_mode + screen_capture) ===
/term.line_no on
/ss.svg
/ss.txt

# ── JSON mode (session dial + per-call flag) ────────────────────────────────
# The session is either in JSON mode or prose mode; /term.request on flips
# EVERYTHING to envelopes -- termapy commands and bare device commands
# alike.  Deterministic subset only: bare /var (datetime values) and
# /port.list (real hardware) stay out; single-name /var and the demo
# device's fixed replies are exact.  elapsed_s is masked by the harness.
/print === section: json mode ===
/term.line_no --json
# The suffix form: the same envelope as --json
/term.line_no.json
/term.request on
/print hello enveloped
/var.set GOLD 42
/var GOLD
AT
AT+PROD-ID
/nope_bogus_cmd
# One user command = ONE envelope: the bare_sub redirect (/mem -> /mem.info)
# must not nest the inner envelope inside output_lines
/mem
/term.request off
# A bare device line with --json is one request/response (per-call form of the dial)
MEM.R 0x1000 2 --json
/print prose is back

# ── Coverage: one family per line that the sections above do not reach ─────
# State here: DEMO connected, symbol table loaded, no profile, no capture,
# prose mode.  Deterministic lines only: no absolute path, no pid, no reply
# that arrives on its own time.  A command that cannot be here is listed with
# why in tests/test_architecture.py (registry command-in-gold).
/print === section: coverage: terminal settings ===
/term.echo
/term.encoding
/term.eol
/term.eol.markers
/term.eol.rx
/term.hex
/proto.hex
/term.json_fmt
/term.output
/term.send_bare_enter
/term.control_keys
/term.timestamps
# The live counts are a TUI display: the CLI refuses the toggle by capability
/term.traffic
/term.color
/term.color on
/term.color off
/term.ctrl 1
/term.info
/term.log a line for the session log, not the screen
/port.mode
# /raw sends no line ending; the device line after it completes the command
/raw AT
+PROD-ID
