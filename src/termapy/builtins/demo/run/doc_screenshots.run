# Generate documentation images

# Run while connected to the demo device:
#   /run doc_screenshots
#
# Images are saved to the ss/ folder as SVG files.
# For manual modal screenshots (Quick Setup, Config Picker),
# use Ctrl+S while the dialog is open.

# -- 1. Hero image: show a realistic session with variety --
/cls
AT+INFO
/delay.silent 2s
AT+TEMP
/delay.silent 2s
/temp_plot 20
/delay.silent 2s
AT+LED on
/delay.silent 2s
AT+STATUS
/delay.silent 2s
/ss.svg.silent doc_01_main_tui

# -- 2. Help overview: top-level commands --
/cls
/help
/delay.silent 2s
/ss.svg.silent doc_02_help

# -- 3. Help detail: proto subcommands --
/cls
/help proto
/delay.silent 2s
/ss.svg.silent doc_03_help_proto

# -- 4. Proto send: hex with response --
/cls
/proto.send "rev\r"
/delay.silent 2s
/ss.svg.silent doc_04_proto_send

# -- 5. Proto send with CRC --
/cls
/proto.send crc16-modbus 01 03 00 00 00 0A
/delay.silent 2s
/ss.svg.silent doc_05_proto_crc

# -- 6. Proto send with delay --
/cls
/proto.send 00 ~25ms "AT+INFO\r"
/delay.silent 2s
/ss.svg.silent doc_06_proto_delay

# -- 7. CRC code generation --
/cls
/proto.crc.python crc16-modbus
/delay.silent 2s
/ss.svg.silent doc_07_crc_python

# -- 8. Variable listing --
/cls
/var
/delay.silent 2s
/ss.svg.silent doc_08_variables

# -- 9. Device target commands --
/cls
/help.target
/delay.silent 2s
/ss.svg.silent doc_09_target_help

# -- 10. Config info (verbose) --
/cls
/term.output verbose
/cfg.load demo
/delay.silent 2s
/ss.svg.silent doc_10_config_info
/term.output normal

# -- 11. Protocol test run: PASS/FAIL results --
/cls
/proto.run modbus_inline.pro
/delay.silent 2s
/ss.svg.silent doc_11_proto_run

# -- 12. Structured capture decoded to CSV, echo on --
/cls
/cap.struct doc_cap_$(n000).csv fmt=Label:S1-10 Counter:U11 Val16:U13-12 Val32:U17-14 Temp:F21-18 records=10 echo=on cmd=AT+BINDUMP 10
/delay.silent 3s
/ss.svg.silent doc_12_cap_struct

# -- 13. (doc_13_cap_progress is NOT taken here: while a script runs,
#        the script-progress bar owns the toolbar, so the capture
#        overlay never shows.  Take it at idle instead:
#          /cap.text doc_progress.txt timeout=15s
#          /ss.svg.silent doc_13_cap_progress
#          /cap.stop                                                --

# -- 14. Port table (set TERMAPY_DEMO_FLEET=1 first for the fixed
#        three-port synthetic fleet; otherwise your real ports show) --
/cls
/port.list
/delay.silent 2s
/ss.svg.silent doc_14_port_list

# -- 15. XMODEM pull from the demo device's virtual filesystem --
/cls
AT+FS.LIST
/delay.silent 1s
AT+XMODEM=SEND device_log.txt
/xfer.xmodem.recv doc_xfer_$(n000).bin
/delay.silent 2s
/ss.svg.silent doc_15_xfer

# -- 16. (doc_16_toolbar is NOT taken here for the same reason as 13:
#        the idle toolbar is replaced by the script bar during a run.
#        Take it at idle: /cls then /ss.svg.silent doc_16_toolbar   --

# -- 17. Interactive proto debug screen (kept last: it pushes a
#        full-screen view that stays open when the script ends) --
/proto.debug modbus_inline.pro
/delay.silent 2s
/ss.svg.silent doc_17_proto_debug
