#!/bin/sh
# Termapy launcher for the __NAME__ config.
# Opens Terminal.app and runs termapy with the cfg dir preloaded.
#
# Generated by /cfg.icon -- regenerate after moving the cfg directory.

osascript <<EOF
tell application "Terminal"
    activate
    do script "'__PYTHON__' -m termapy '__CFG_PATH__'"
end tell
EOF
