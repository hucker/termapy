#!/bin/sh
# Refuse a commit that is unformatted, or that ruff or ty would flag
# (CLAUDE.md, "Precommit").
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# Checks the working tree, not just the staged snapshot -- a partial
# stage is judged by the files as they sit on disk.  The test suite is
# not run here (about a minute); run it before committing as usual.

# uv warns on every run that VIRTUAL_ENV points somewhere other than the
# project .venv; the warning is noise here, so drop the variable.
unset VIRTUAL_ENV

# --no-cache: the cache records what `ruff format` wrote as formatted, and
# ruff's layout can still move on a second pass (it did, 2026-10-17), so a
# cached check can pass a tree a fresh clone fails.  The full check is ~1 s.
echo "pre-commit: ruff format --check --no-cache"
if ! uv run --no-sync ruff format --check --no-cache; then
    echo "pre-commit: unformatted files -- run: uv run ruff format.  Commit refused." >&2
    exit 1
fi

# ruff and ty take no paths, the same as the format check: they cover the
# whole project, and the excludes in pyproject.toml ([tool.ruff],
# [tool.ty.src]) are the gate's scope.  Naming folders here left scripts/
# and examples/ unchecked, and would do the same to the next new one.
echo "pre-commit: ruff check"
if ! uv run --no-sync ruff check; then
    echo "pre-commit: ruff found issues -- commit refused." >&2
    exit 1
fi

echo "pre-commit: ty check"
if ! uv run --no-sync ty check; then
    echo "pre-commit: ty found issues -- commit refused." >&2
    exit 1
fi
