{
  "profile_version": 2,
  "profile_revision": "1.0.0",
  "profile_date": "2026-05-02",

  "device": {
    "name": "BASSOMATIC (NDJSON simulator)",
    "vendor": "termapy",
    "model": "DEMO_JSON",
    "startup_banner": "\"event\"\\s*:\\s*\"ready\""
  },

  "commands": {
    "get_temp": {
      "help": "Read temperature in Celsius.",
      "safety": "readonly",
      "response": {"format": "json", "timeout_ms": 200}
    },
    "get_status": {
      "help": "Return full device status snapshot (JSON).",
      "safety": "readonly",
      "response": {"format": "json", "timeout_ms": 500}
    },
    "set_threshold": {
      "help": "Set the high-temperature alarm threshold.",
      "typed_args": [
        {"name": "celsius", "type": "float", "required": true,
         "help": "Threshold in degrees Celsius.", "min": -40.0, "max": 125.0}
      ],
      "safety": "mutable",
      "rate_limit_hz": 10,
      "response": {"format": "json", "timeout_ms": 500}
    },
    "set_mode": {
      "help": "Switch operating mode.",
      "typed_args": [
        {"name": "mode", "type": "str", "required": true,
         "help": "Operating mode.",
         "enum": ["idle", "active", "sleep", "diagnostic"]}
      ],
      "safety": "mutable",
      "response": {"format": "json", "timeout_ms": 500}
    },
    "calibrate": {
      "help": "Begin in-place calibration.  Async events report progress.",
      "safety": "destructive",
      "response": {"format": "json", "timeout_ms": 1000}
    },
    "reset": {
      "help": "Soft reset.  Banner re-emits after.  Fire-and-forget.",
      "safety": "destructive",
      "response": {"format": "none", "timeout_ms": 0}
    }
  }
}
