# CLI gold-standard test - deterministic commands only
# Exercises device commands, REPL commands, variables, config, port control,
# protocol CRC, environment variables, and error handling.
# Skip: /delay, /confirm, /grep, /ss, /cls, /cap, /os, /run (nested)
# Skip: AT+TEMP, AT+INFO, AT+STATUS, AT+RESET, NMEA (nondeterministic)
# Skip: /port.list (hardware-dependent)

# ── Device commands ──────────────────────────────────────────────────────────
/print === section: device commands ===
AT
AT+PROD-ID
AT+LED on
AT+LED off
AT+NAME?
AT+NAME=TestDevice
AT+NAME?
AT+BAUD?
mem 0x1000 32
mem 0x2000 16
AT+TEXTDUMP 3
BOGUS
AT+LED on
AT+LED off

# ── REPL: print and echo ────────────────────────────────────────────────────
# /term.echo governs echo of DEVICE commands; /term.echo_repl governs echo of
# REPL/slash commands like /print (see the two-echo split).  This section
# toggles the REPL echo since it exercises slash commands.
/print === section: print and echo ===
/term.echo_repl off
/print repl echo is off - this output appears, with no command-echo above it
/term.echo_repl on
/print repl echo is on - this output appears with its command-echo above it

# ── REPL: variables (set/use/clear, but don't list all - times are dynamic)
/print === section: variables ===
$(DEVICE) = BASSOMATIC
$(PORT_NUM) = 42
/print device=$(DEVICE) port=$(PORT_NUM)
/var DEVICE
/var PORT_NUM
/var.set DEVICE updated_value
/var DEVICE
$(BAUD) <- /port.baud_rate
/var BAUD
/var.clear
/var DEVICE

# ── REPL: config queries ────────────────────────────────────────────────────
/print === section: config read ===
/cfg baud_rate
/cfg encoding
/cfg eol
/cfg parity
/cfg byte_size
/cfg stop_bits
/cfg flow_control
/cfg echo
/cfg send_bare_enter
/cfg cmd_prefix

# ── REPL: config auto-set (no confirmation dialog) ──────────────────────────
/print === section: config auto-set ===
/cfg.auto echo true
/cfg echo
/cfg.auto echo false
/cfg echo

# ── REPL: config dump (full JSON) ───────────────────────────────────────────
/print === section: config dump ===
/cfg.dump

# ── REPL: config folder listings ────────────────────────────────────────────
/print === section: config folders ===
/run.list
/proto.list

# ── REPL: port control - read all properties ────────────────────────────────
/print === section: port read ===
/port.baud_rate
/port.parity
/port.byte_size
/port.stop_bits
/port.flow_control
/port.dtr
/port.rts
/port.cts
/port.dsr
/port.ri
/port.cd
/port.info

# ── REPL: port control - modify properties ──────────────────────────────────
/print === section: port modify ===
/port.dtr 0
/port.dtr
/port.dtr 1
/port.dtr
/port.rts 0
/port.rts

# ── REPL: port control - disconnect and reconnect ───────────────────────────
/print === section: port disconnect/connect ===
/port.disconnect
/port.baud_rate
/port.connect
/port.baud_rate

# ── REPL: port break ────────────────────────────────────────────────────────
/print === section: port break ===
/port.break
/port.break 100

# ── REPL: port subcommand listing ───────────────────────────────────────────
/print === section: port subcommands ===
/port

# ── REPL: show_line_endings toggle ──────────────────────────────────────────
/print === section: line endings ===
/show_line_endings on
/show_line_endings off

# ── REPL: sequence counters ─────────────────────────────────────────────────
/print === section: seq ===
/seq
/print seq1={seq1+} seq2={seq2+}
/print seq1={seq1+} seq2={seq2}
/seq
/seq.reset
/seq

# ── REPL: protocol CRC tools ────────────────────────────────────────────────
/print === section: proto crc ===
/proto.crc.info crc16-modbus
/proto.crc.calc crc16-modbus 01 03 00 00 00 0A
/proto.crc.calc crc8-maxim 48 65 6C 6C 6F
/proto.crc.calc crc32 01 02 03 04

# ── REPL: help for specific commands ────────────────────────────────────────
/print === section: help ===
/help echo
/help port
/help cfg
/help var
/help cap
/help ss
/help proto
/help plugin
/help run
/print === section: help.run ===
/help.run
/print === section: help.plugin ===
/help.plugin

# ── REPL: cap.poll ──────────────────────────────────────────────────────────
/print === section: cap.poll ===
/cap.poll count=3 delay=0 --notime cmd=AT+RAMP
# param error: enum value not in the allowed set (fails at parse, deterministic)
/cap.poll fmt=bogus cmd=AT

# ── REPL: repeat ────────────────────────────────────────────────────────────
/print === section: repeat ===
/repeat count=3 cmd=/print hello
/repeat count=3 var=I cmd=/print iteration $(I)
/repeat cmd=AT
/repeat count=0 cmd=AT
/repeat count=abc cmd=AT
# more param errors: bad duration value, and an unexpected positional token
/repeat count=1 delay=xyz cmd=AT
/repeat foo count=1 cmd=AT

# ── REPL: environment variables ─────────────────────────────────────────────
/print === section: env vars ===
/env.set TEST_VAR hello_world
/env.list TEST_VAR
/env.set TEST_VAR updated
/env.list TEST_VAR

# ── REPL: error handling ────────────────────────────────────────────────────
/print === section: errors ===
/nonexistent_command
/cfg nonexistent_key
/port.baud_rate not_a_number
/port.parity X
/port.dtr maybe
/port.break -5

# ── Capability gates (tui_mode + screen_capture) ────────────────────────────
# Demo CLI lacks TUI capabilities, so commands declaring tui_mode or
# screen_capture fail with a uniform "/cmd requires: <cap> (not available in
# this environment)" message.  Other capability gates (serial_connected,
# block_until) are covered by unit tests because the gold harness runs in
# --demo mode (connected), which satisfies serial_connected, and .run files
# satisfy block_until -- neither reaches the gate here.
/print === section: capability gates (tui_mode + screen_capture) ===
/line_no on
/ss.svg
/ss.txt
