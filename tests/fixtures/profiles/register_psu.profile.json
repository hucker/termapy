{
  "profile_version": 2,
  "profile_revision": "0.3.0",
  "profile_date": "2026-04-30",

  "device": {
    "name": "Lab PSU (register-readback style)",
    "vendor": "Reference",
    "prompt": "psu> "
  },

  "error_detection": {
    "pattern": "^ERR=(?P<code>\\d+)\\s*(?P<message>.*)$",
    "async": false,
    "types": {"code": "int", "message": "str"},
    "codes": {
      "1": "syntax",
      "2": "out of range",
      "10": "busy",
      "20": "interlock open"
    }
  },

  "commands": {
    "*IDN?": {
      "help": "Standard IEEE-488.2 identification.",
      "safety": "readonly",
      "response": {
        "format": "regex",
        "pattern": "(?P<vendor>[^,]+),(?P<model>[^,]+),(?P<sn>[^,]+),(?P<fw>.+)",
        "types": {"vendor": "str", "model": "str", "sn": "str", "fw": "str"},
        "timeout_ms": 500
      }
    },
    "VOLT?": {
      "help": "Read output voltage (volts).",
      "safety": "readonly",
      "response": {
        "format": "regex",
        "pattern": "(?P<volts>-?\\d+\\.\\d+)",
        "types": {"volts": "float"},
        "timeout_ms": 300
      }
    },
    "VOLT": {
      "help": "Set output voltage in volts.",
      "send_template": "VOLT {v:.3f}",
      "typed_args": [
        {"name": "v", "type": "float", "required": true,
         "help": "Volts. 0.0 .. 30.0.", "min": 0.0, "max": 30.0}
      ],
      "safety": "destructive",
      "rate_limit_hz": 5,
      "response": {"format": "none", "timeout_ms": 0}
    },
    "CHAN?": {
      "help": "List configured output channels.",
      "safety": "readonly",
      "response": {
        "format": "lines",
        "terminator": "^END$",
        "line_pattern": "CH(?P<id>\\d+)\\s+V=(?P<volts>-?\\d+\\.\\d+)\\s+I=(?P<amps>-?\\d+\\.\\d+)\\s+(?P<state>ON|OFF)",
        "line_types": {"id": "int", "volts": "float", "amps": "float", "state": "str"},
        "timeout_ms": 1000
      }
    },
    "ERR?": {
      "help": "Pop the next entry from the error queue.",
      "safety": "readonly",
      "response": {
        "format": "regex",
        "pattern": "(?P<code>-?\\d+),\"(?P<message>[^\"]*)\"",
        "types": {"code": "int", "message": "str"},
        "timeout_ms": 200
      }
    }
  }
}
