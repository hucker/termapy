# Git hooks run under sh, which chokes on CRLF; keep them LF on every
# checkout regardless of core.autocrlf.
.githooks/* text eol=lf
scripts/*.sh text eol=lf

# Python files can be diffed as ruff formats them (scripts/format_textconv.sh),
# so a comparison across the 2026-10-17 formatting commit shows real changes
# only.  Inert until a command opts in with -c diff.ruff-format.textconv=...
*.py diff=ruff-format

# ELF test fixtures (tests/fixtures/elf/) are compiler output: never
# convert line endings in them or diff them as text.
*.elf binary

# The device-side sources ship in the wheel byte for byte: LF on every
# checkout, so a wheel built on Windows and one built on Linux hold the
# same files (and the listing's sizes agree).
src/termapy/firmware/** text eol=lf
